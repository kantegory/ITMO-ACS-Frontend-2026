{
  "name": "vue-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently --names api,vue \"npm run api\" \"vite --host 127.0.0.1 --port 8080\"",
    "api": "json-server db.json -m ./node_modules/json-server-auth --host 127.0.0.1 --port 3000",
    "dev": "npm start",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "bootstrap": "^5.3.9",
    "pinia": "^4.1.0",
    "pinia-persists": "^1.2.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.7",
    "json-server": "^0.17.4",
    "json-server-auth": "2.1",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
