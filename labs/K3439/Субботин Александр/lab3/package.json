{
  "name": "stolik-vue",
  "version": "1.0.0",
  "private": true,
  "description": "Столик — бронирование столиков в ресторанах. ЛР3: SPA на Vue.js",
  "type": "module",
  "scripts": {
    "start": "run-p api dev",
    "dev": "vite",
    "api": "json-server db.json -m ./node_modules/json-server-auth -r routes.json --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "axios": "^1.21.0",
    "bootstrap": "5.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.10.0",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "globals": "^17.12.0",
    "json-server": "^0.17.4",
    "json-server-auth": "^2.1.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
