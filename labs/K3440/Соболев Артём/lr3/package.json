{
  "name": "fitness-platform-lr3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 8081",
    "dev": "vite --host 127.0.0.1 --port 8081",
    "server": "node server.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8081",
    "format": "prettier --write --html-whitespace-sensitivity ignore src server.js vite.config.js package.json README.md reports/*.md",
    "format:check": "prettier --check --html-whitespace-sensitivity ignore src server.js vite.config.js package.json README.md reports/*.md"
  },
  "dependencies": {
    "axios": "^1.0.0",
    "bootstrap": "^5.3.3",
    "json-server": "0.17.4",
    "json-server-auth": "^2.1.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.9.10",
    "vite": "^7.0.0"
  }
}
