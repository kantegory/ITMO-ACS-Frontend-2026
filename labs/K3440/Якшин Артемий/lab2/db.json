      "createdAt": "2026-10-09T11:05:00"
    },
    {
      "id": 4,
      "recipeId": 2,
      "userId": 7,
      "text": "Наконец-то борщ не стал коричневым, спасибо за совет с уксусом.",
      "createdAt": "2026-10-07T20:15:00"
    },
    {
      "id": 5,
      "recipeId": 3,
      "userId": 5,
      "text": "Готовлю по выходным, с фетой ещё вкуснее.",
      "createdAt": "2026-10-11T10:30:00"
    },
    {
      "id": 6,
      "recipeId": 4,
      "userId": 1,
      "text": "Сливки больше не добавляю, соус и так кремовый.",
      "createdAt": "2026-10-12T19:00:00"
    },
    {
      "id": 7,
      "recipeId": 7,
      "userId": 3,
      "text": "Любимый пирог моей бабушки, рецепт один в один.",
      "createdAt": "2026-10-20T16:45:00"
    },
    {
      "id": 8,
      "recipeId": 9,
      "userId": 6,
      "text": "Идеально для перекуса после тренировки.",
      "createdAt": "2026-10-26T08:20:00"
    },
    {
      "id": 9,
      "recipeId": 11,
      "userId": 3,
      "text": "Отличный первый рецепт! Попробуй добавить немного тёртого сыра.",
      "createdAt": "2026-11-02T09:00:00"
    }
  ],
