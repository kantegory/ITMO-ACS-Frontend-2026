FROM golang:1.25-alpine
ARG SERVICE
ARG REVISION=dev
ENV SERVICE=${SERVICE} REVISION=${REVISION}
WORKDIR /app
RUN apk add --no-cache git
COPY go.mod go.sum ./
RUN go mod download
RUN go install -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate@v4.18.3 && cp /go/bin/migrate /app/migrate
COPY . .
CMD ["sh", "-c", "go build -ldflags=\"-X restaurant-booking/internal/buildinfo.Revision=${REVISION}\" -o /tmp/service ./${SERVICE}/cmd/${SERVICE} && exec /tmp/service"]
